params {
    // Set default values for alignment filtering
    min_qcov = 0.3
    min_pid  = 0.4
}

process {
    withName: MINIMAP2_ALIGN {
        ext.args = "-k 13 -w 5"
    }

    withName: SEQKIT_GREP {
        ext.args   = "--invert-match"
    }

    withName: '.*:HUMAN_DECONTAMINATE_CONTIGS:FILTERPAF' {
        // MultiQC custom-content front-matter header (id, section_name, pconfig.title)
        // naming the reference genome that was actually used for this assembly.
        ext.mqc_id      = 'human_decontamination'
        ext.mqc_section = { "Human contaminated contigs (${meta.human_reference})" }
        ext.mqc_title   = { "Human Contamination Removal (${meta.human_reference})" }
    }

    withName: '.*:PHIX_DECONTAMINATE_CONTIGS:FILTERPAF' {
        // MultiQC custom-content front-matter header (id, section_name, pconfig.title)
        // naming the reference genome that was actually used for this assembly.
        ext.mqc_id      = 'phix_decontamination'
        ext.mqc_section = { "PhiX contaminated contigs (${meta.phix_reference})" }
        ext.mqc_title   = { "PhiX Contamination Removal (${meta.phix_reference})" }
    }

    withName: '.*:HOST_DECONTAMINATE_CONTIGS:FILTERPAF' {
        // MultiQC custom-content front-matter header (id, section_name, pconfig.title)
        // naming the reference genome/database that was actually used for this assembly.
        ext.mqc_id      = 'host_decontamination'
        ext.mqc_section = { "Host/Contaminant contaminated contigs (${meta.contaminant_reference})" }
        ext.mqc_title   = { "Host/Contaminant Removal (${meta.contaminant_reference})" }
    }
}
