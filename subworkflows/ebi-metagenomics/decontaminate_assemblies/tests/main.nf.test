                    assert host_mqc_lines[3] == "# pconfig:"
                    assert host_mqc_lines[4] == "#     id: 'host_decontamination_table'"
                    assert host_mqc_lines[5] == "#     title: 'Host/Contaminant Removal (contamination)'"
                    assert host_mqc_lines[6] == "sequence_id\tquery_coverage\tidentity"
