    }

    test("decontaminate_assemblies - multiple samples") {

        when {
            params {
                reference_genomes_folder = "${moduleDir}/tests/data"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [
                            id: 'sample1',
                            phix_reference: 'phix',
                            human_reference: 'human',
                            contaminant_reference: null
                        ],
                        file("${moduleDir}/tests/data/test.fasta", checkIfExists: true)
                    ],
                    [
                        [
                            id: 'sample2',
                            phix_reference: null,
                            human_reference: null,
                            contaminant_reference: 'contamination'
                        ],
                        file("${moduleDir}/tests/data/test.fasta", checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.cleaned_contigs,
                    workflow.out.versions.collect { path(it).yaml }.unique()
                    ).match()
                },
            )
        }
    }
}
