
nextflow_process {

    name "Test Process FILTERPAF"
    script "../main.nf"
    process "FILTERPAF"

    tag "modules"
    tag "modules_ebimetagenomics"
    tag "filterpaf"

    test("filterpaf") {

        when {
            params {
                min_qcov = 0.3
                min_pid  = 0.4
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.paf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("filterpaf - mqc header") {

        when {
            params {
                min_qcov = 0.3
                min_pid  = 0.4
            }
            process {
                config "./nextflow.config"

                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.paf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def mqc_lines = path(process.out.mapped_contigs_tsv_mqc.get(0).get(1)).linesGzip
                    assert mqc_lines[0] == "# id: 'test_decontamination'"
                    assert mqc_lines[1] == "# section_name: 'Test contaminated contigs'"
                    assert mqc_lines[2] == "# plot_type: 'table'"
                    assert mqc_lines[3] == "# pconfig:"
                    assert mqc_lines[4] == "#     id: 'test_decontamination_table'"
                    assert mqc_lines[5] == "#     title: 'Test Contamination Removal'"
                    assert mqc_lines[6] == "sequence_id\tquery_coverage\tidentity"
                },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("filterpaf - stub") {

        options "-stub"

        when {
            params {
                min_qcov = 0.3
                min_pid  = 0.4
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/test.paf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
