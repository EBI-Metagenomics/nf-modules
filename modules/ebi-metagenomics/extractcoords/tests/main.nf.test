nextflow_process {

    name "Test Process EXTRACTCOORDS"
    script "../main.nf"
    process "EXTRACTCOORDS"

    tag "modules"
    tag "modules_ebimetagenomics"
    tag "extractcoords"

    test("test.fasta - separate subunits") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test.fasta", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test_matched_seqs_with_coords.txt", checkIfExists: true)
                ]
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("test.fasta - no separate subunits") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test.fasta", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test_matched_seqs_with_coords.txt", checkIfExists: true)
                ]
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interleaved ncRNA - separate subunits") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/interleaved_ncrna.fasta", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/interleaved_ncrna_coords.txt", checkIfExists: true)
                ]
                input[2] = true
                """
            }
        }

        then {
            def ncrna = path(process.out.ncrna_fasta[0][1]).fasta
            assertAll(
                { assert process.success },
                { assert ncrna.size() == 4 },
                { assert ncrna['test_0-Hatchet/1-40'] == 'ACGT' * 10 },
                { assert ncrna['test_1-Cobalamin/1-12000'] == 'TGCA' * 3000 },
                { assert ncrna['test_2-Hatchet/1-48'] == 'GATC' * 12 },
                { assert ncrna['test_3-Bacteria_large_SRP/1-52'] == 'CATG' * 13 },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interleaved ncRNA - no separate subunits") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/interleaved_ncrna.fasta", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/interleaved_ncrna_coords.txt", checkIfExists: true)
                ]
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("test.fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test.fasta", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test' ], // meta map
                    file("${moduleDir}/tests/test_matched_seqs_with_coords.txt", checkIfExists: true)
                ]
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
