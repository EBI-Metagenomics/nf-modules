nextflow_process {

    name "Test Process READSORIENTATIONCHECK"
    script "../main.nf"
    process "READSORIENTATIONCHECK"
    config "./nextflow.config"

    tag "modules"
    tag "modules_ebimetagenomics"
    tag "readsorientationcheck"

    // The FASTQ fixtures are plain text so they are easy to inspect.
    // Raw reads are usually gzip-compressed, so the paired-end tests compress the fixtures first.
    def gzipFixture = { String fastq, Object targetDir ->
        def gz = new File(targetDir.toString(), new File(fastq).name + ".gz")
        gz.parentFile.mkdirs()
        new java.util.zip.GZIPOutputStream(new FileOutputStream(gz)).withStream { it << new File(fastq).bytes }
        return gz.path
    }

    test("paired-end - mixed") {

        when {
            def r1 = gzipFixture("${moduleDir}/tests/data/mixed_1.fastq", outputDir)
            def r2 = gzipFixture("${moduleDir}/tests/data/mixed_2.fastq", outputDir)
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file("${r1}", checkIfExists: true),
                        file("${r2}", checkIfExists: true)
                    ]
                ]
                input[1] = file("${moduleDir}/tests/data/RF00001.cm", checkIfExists: true)
                input[2] = 24
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.classification[0][1] == "mixed" },
                { assert snapshot(
                    process.out.tsv,
                    process.out.classification,
                    // The comment lines of the table have the run date and directory
                    path(process.out.cmsearch_tbl[0][1]).linesGzip.findAll { !it.startsWith('#') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("paired-end - not mixed") {

        when {
            def r1 = gzipFixture("${moduleDir}/tests/data/not_mixed_1.fastq", outputDir)
            def r2 = gzipFixture("${moduleDir}/tests/data/not_mixed_2.fastq", outputDir)
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file("${r1}", checkIfExists: true),
                        file("${r2}", checkIfExists: true)
                    ]
                ]
                input[1] = file("${moduleDir}/tests/data/RF00001.cm", checkIfExists: true)
                input[2] = 24
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.classification[0][1] == "not_mixed" },
                { assert snapshot(
                    process.out.tsv,
                    process.out.classification,
                    // The comment lines of the table have the run date and directory
                    path(process.out.cmsearch_tbl[0][1]).linesGzip.findAll { !it.startsWith('#') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("single-end - mixed") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file("${moduleDir}/tests/data/mixed_1.fastq", checkIfExists: true)
                ]
                input[1] = file("${moduleDir}/tests/data/RF00001.cm", checkIfExists: true)
                input[2] = 24
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.classification[0][1] == "mixed" },
                { assert snapshot(
                    process.out.tsv,
                    process.out.classification,
                    // The comment lines of the table have the run date and directory
                    path(process.out.cmsearch_tbl[0][1]).linesGzip.findAll { !it.startsWith('#') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("paired-end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file("${moduleDir}/tests/data/mixed_1.fastq", checkIfExists: true),
                        file("${moduleDir}/tests/data/mixed_2.fastq", checkIfExists: true)
                    ]
                ]
                input[1] = file("${moduleDir}/tests/data/RF00001.cm", checkIfExists: true)
                input[2] = 24
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
