nextflow_process {

    name "Test Process SANNTIS"
    script "../main.nf"
    process "SANNTIS"

    tag "modules"
    tag "modules_ebimetagenomics"
    tag "sanntis"

    test("interproscan tsv and faa") {

        when {
            process {
                """
                input[0] = [
                    [ id:'BGC0001472' ], // meta map
                    file("https://raw.githubusercontent.com/Finn-Lab/SanntiS/refs/tags/v0.9.6/test/files/BGC0001472.fna.prodigal.faa.gff3", checkIfExists: true),
                    [],
                    file("https://raw.githubusercontent.com/Finn-Lab/SanntiS/refs/tags/v0.9.6/test/files/BGC0001472.fna.prodigal.faa", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interproscan tsv and faa both compress") {

        when {
            process {
                """
                input[0] = [
                    [ id:'BGC0001472' ], // meta map
                    file("${moduleDir}/tests/fixtures/BGC0001472.fna.prodigal.faa.gff3.gz", checkIfExists: true),
                    [],
                    file("${moduleDir}/tests/fixtures/BGC0001472.fna.prodigal.faa.gz", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interproscan gff and faa not in genomic order") {

        // Regression test for the --is_protein CDS ordering bug fixed in SanntiS v0.9.6.
        // The shuffled FASTA holds the same proteins as BGC0001472.fna.prodigal.faa.gz,
        // none of them at its original position. SanntiS <= v0.9.5.0 took the FASTA order
        // as the gene order along the contig and reported a wrong CLUSTER.
        // The result must be the same as for the FASTA in genomic order (the tests above).

        when {
            process {
                """
                input[0] = [
                    [ id:'BGC0001472' ], // meta map
                    file("${moduleDir}/tests/fixtures/BGC0001472.fna.prodigal.faa.gff3.gz", checkIfExists: true),
                    [],
                    file("${moduleDir}/tests/fixtures/BGC0001472.fna.prodigal.shuffled.faa.gz", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            def clusters = path(process.out.gff[0][1]).linesGzip
                .findAll { !it.startsWith("#") }
                .collect { it.split("\t") }
                .findAll { it[2] == "CLUSTER" }
            assertAll(
                // seqid, start, end of each CLUSTER, as predicted for the FASTA in genomic order
                { assert clusters.collect { [it[0], it[3], it[4]] } == [["BGC0001472", "312", "19485"]] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("interproscan tsv and faa - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'BGC0001472' ], // meta map
                    file("https://raw.githubusercontent.com/Finn-Lab/SanntiS/refs/tags/v0.9.6/test/files/BGC0001472.fna.prodigal.faa.gff3", checkIfExists: true),
                    [],
                    file("https://raw.githubusercontent.com/Finn-Lab/SanntiS/refs/tags/v0.9.6/test/files/BGC0001472.fna.prodigal.faa", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
